{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "WHATSAPP_PROVIDER",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_BUSINESS_ACCOUNT_ID",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
    "WHATSAPP_TEMPLATE_DAILY_MORNING",
    "WHATSAPP_TEMPLATE_REAL_TIME_PEAK",
    "WHATSAPP_TEMPLATE_STREAK_RISK",
    "WHATSAPP_TEMPLATE_WEEKLY_SUMMARY",
    "WHATSAPP_COST_GUARD_WEEKLY_MESSAGES_PER_STUDENT",
    "WHATSAPP_COST_GUARD_WEEKLY_RESET_DAY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_WHATSAPP_FROM",
    "CREDENTIAL_SIGNING_SECRET",
    "CREDENTIAL_PUBLIC_BASE_URL",
    "CREDENTIAL_SNAPSHOT_REFRESH_DELTA",
    "PLACEMENT_PREDICTION_MODEL_VERSION",
    "PLACEMENT_PREDICTION_MIN_DAYS",
    "NUDGE_DEFAULT_DAILY_LOCAL_TIME",
    "NUDGE_DEFAULT_WEEKLY_LOCAL_DAY",
    "NUDGE_DEFAULT_WEEKLY_LOCAL_TIME",
    "NUDGE_DEFAULT_QUIET_START",
    "NUDGE_DEFAULT_QUIET_END",
    "NUDGE_EXAM_WEEK_KEYWORD_DENSITY_THRESHOLD",
    "NUDGE_POWER_MODE_BADGE_FRESHNESS_HOURS",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "ANTICHEAT_QUARANTINE_THRESHOLD",
    "ANTICHEAT_AI_FINGERPRINT_PROVIDER",
    "GREENHOUSE_API_BASE",
    "LEVER_API_BASE",
    "ATS_SYNC_MAX_ATTEMPTS",
    "ATS_SYNC_CRON_MINUTES",
    "NEXT_PUBLIC_DEFAULT_LOCALE",
    "NEXT_PUBLIC_SUPPORTED_LOCALES",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_REDIRECT_URI",
    "WORKOS_COOKIE_PASSWORD",
    "MOCK_INTERVIEW_PROVIDER",
    "MOCK_INTERVIEW_API_KEY",
    "MOCK_INTERVIEW_MODEL",
    "MOCK_INTERVIEW_WEEKLY_TOKEN_CAP",
    "MOCK_INTERVIEW_MONTHLY_TENANT_TOKEN_CAP",
    "MOCK_INTERVIEW_MAX_SCORE_CONTRIBUTION_PCT",
    "HACKATHON_CPU_SECONDS",
    "HACKATHON_MEMORY_MB",
    "HACKATHON_DISALLOW_NETWORK",
    "PUBLIC_API_DEFAULT_RATE_LIMIT_RPM",
    "PUBLIC_API_BURST_RPS",
    "PWA_ENABLED",
    "PWA_OFFLINE_PAGE",
    "OUTCOME_BILLING_DISPUTE_WINDOW_DAYS",
    "NEXT_BEST_SKILL_MIN_SOURCE_COUNT",
    "NEXT_BEST_SKILL_RECOMPUTE_CRON_HOURS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
