# Antarix Environment Variables
# Copy this file to .env.local and fill in actual values

# =============================================================================
# Supabase
# =============================================================================
# Local development: get these from `npx supabase start` output
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# GitHub OAuth (for student integrations)
# =============================================================================
# Create app at https://github.com/settings/developers
# Callback URL: ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Google OAuth (for Calendar integration)
# =============================================================================
# Create app at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Chrome Extension (uses Vite env vars, prefix with VITE_)
# =============================================================================
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_EXTENSION_VERSION=0.1.0

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Antarix
NODE_ENV=development

# =============================================================================
# WhatsApp — Meta Cloud API (preferred) — see spec/002 research.md Decision A
# =============================================================================
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_64_char_random_string
WHATSAPP_TEMPLATE_DAILY_MORNING=antarix_daily_morning_v1
WHATSAPP_TEMPLATE_REAL_TIME_PEAK=antarix_peak_window_v1
WHATSAPP_TEMPLATE_STREAK_RISK=antarix_streak_risk_v1
WHATSAPP_TEMPLATE_WEEKLY_SUMMARY=antarix_weekly_summary_v1

# Defensive cost guard (see spec/002 A-011)
WHATSAPP_COST_GUARD_WEEKLY_MESSAGES_PER_STUDENT=20
WHATSAPP_COST_GUARD_WEEKLY_RESET_DAY=0

# Twilio fallback (leave blank when using meta_cloud)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# =============================================================================
# Verifiable credential — see spec/002 data-model.md verifiable_credentials
# =============================================================================
CREDENTIAL_SIGNING_SECRET=replace_with_64_char_random_string
CREDENTIAL_PUBLIC_BASE_URL=http://localhost:3000/verify
CREDENTIAL_SNAPSHOT_REFRESH_DELTA=3

# =============================================================================
# Placement prediction — see spec/002 research.md Decision D
# =============================================================================
PLACEMENT_PREDICTION_MODEL_VERSION=v1-rule-augmented
PLACEMENT_PREDICTION_MIN_DAYS=30

# =============================================================================
# Nudge scheduling — see spec/002 data-model.md nudge_preferences
# =============================================================================
NUDGE_DEFAULT_DAILY_LOCAL_TIME=08:00
NUDGE_DEFAULT_WEEKLY_LOCAL_DAY=0
NUDGE_DEFAULT_WEEKLY_LOCAL_TIME=10:00
NUDGE_DEFAULT_QUIET_START=22:00
NUDGE_DEFAULT_QUIET_END=07:00
NUDGE_EXAM_WEEK_KEYWORD_DENSITY_THRESHOLD=0.6
NUDGE_POWER_MODE_BADGE_FRESHNESS_HOURS=24

# Web-push fallback (generate via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# =============================================================================
# DSA sync — see specs/003-engage-and-showcase/research.md (D1, D2)
# =============================================================================
LEETCODE_API_URL=https://leetcode.com/graphql
HACKERRANK_API_URL=https://www.hackerrank.com/rest/hackers

# =============================================================================
# Discord bot (free channel) — see specs/003 research.md D6
# Create app at https://discord.com/developers/applications
# =============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_oauth_client_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/channels/discord/callback
DISCORD_BOT_PUBLIC_KEY=your_bot_public_key_for_signature_verification

# =============================================================================
# Telegram bot (free channel) — see specs/003 research.md D7
# Create via @BotFather
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_no_at
TELEGRAM_WEBHOOK_SECRET=replace_with_32_char_random_string
TELEGRAM_WEBHOOK_URL=http://localhost:54321/functions/v1/bot-webhook

# JWT signing key for one-time Telegram /start tokens
# Reuse SUPABASE_SERVICE_ROLE_KEY if you don't want a separate secret.
CHANNEL_TOKEN_SIGNING_KEY=replace_with_64_char_random_string

# =============================================================================
# 004 — Anti-cheat
# =============================================================================
ANTICHEAT_QUARANTINE_THRESHOLD=0.6
ANTICHEAT_AI_FINGERPRINT_PROVIDER=builtin

# =============================================================================
# 004 — ATS (Greenhouse + Lever)
# =============================================================================
GREENHOUSE_API_BASE=https://harvest.greenhouse.io/v1
LEVER_API_BASE=https://api.lever.co/v1
ATS_SYNC_MAX_ATTEMPTS=3
ATS_SYNC_CRON_MINUTES=5

# =============================================================================
# 004 — i18n
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,hi,ta,te,mr

# =============================================================================
# 004 — Enterprise SSO (WorkOS)
# =============================================================================
WORKOS_API_KEY=<workos-api-key>
WORKOS_CLIENT_ID=<workos-client-id>
WORKOS_REDIRECT_URI=https://<host>/api/sso/workos/callback
WORKOS_COOKIE_PASSWORD=<>=32-char-random-secret

# =============================================================================
# 004 — Mock interview LLM
# =============================================================================
MOCK_INTERVIEW_PROVIDER=groq
MOCK_INTERVIEW_API_KEY=<provider-api-key>
MOCK_INTERVIEW_MODEL=llama-3.1-70b-versatile
MOCK_INTERVIEW_WEEKLY_TOKEN_CAP=50000
MOCK_INTERVIEW_MONTHLY_TENANT_TOKEN_CAP=5000000
MOCK_INTERVIEW_MAX_SCORE_CONTRIBUTION_PCT=5

# =============================================================================
# 004 — Hackathon sandbox
# =============================================================================
HACKATHON_CPU_SECONDS=30
HACKATHON_MEMORY_MB=256
HACKATHON_DISALLOW_NETWORK=true

# =============================================================================
# 004 — Public API
# =============================================================================
PUBLIC_API_DEFAULT_RATE_LIMIT_RPM=100
PUBLIC_API_BURST_RPS=10

# =============================================================================
# 004 — PWA
# =============================================================================
PWA_ENABLED=true
PWA_OFFLINE_PAGE=/offline

# =============================================================================
# 004 — Outcome billing
# =============================================================================
OUTCOME_BILLING_DISPUTE_WINDOW_DAYS=30

# =============================================================================
# 004 — Next-best-skill
# =============================================================================
NEXT_BEST_SKILL_MIN_SOURCE_COUNT=5
NEXT_BEST_SKILL_RECOMPUTE_CRON_HOURS=24
