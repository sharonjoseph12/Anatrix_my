{
  "manifest_version": 3,
  "name": "Antarix Activity Tracker",
  "version": "0.1.0",
  "description": "Track focused learning sessions, sync to Antarix dashboard, and build verified skill profiles.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Antarix Activity Tracker"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
